#!/bin/bash

echo "🔍 Pre-commit hook 실행 중..."

# 포스트 파일(.md) 변경 감지
CHANGED_POSTS=$(git diff --cached --name-only | grep "^src/posts/.*\.md$")

if [ -n "$CHANGED_POSTS" ]; then
    echo "📝 포스트 파일 변경 감지:"
    echo "$CHANGED_POSTS"
    echo ""
    
    # 현재 날짜 (YYYY-MM-DD 형식)
    TODAY=$(date +%Y-%m-%d)
    
    # date 필드 업데이트
    echo "📅 포스트 date 필드 업데이트 중..."
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            # frontmatter의 date 필드를 현재 날짜로 업데이트
            if [[ "$OSTYPE" == "darwin"* ]]; then
                # macOS용
                sed -i '' "s/^date: .*/date: $TODAY/" "$file"
            else
                # Linux용
                sed -i "s/^date: .*/date: $TODAY/" "$file"
            fi
            git add "$file"
            echo "  ✏️  $file"
        fi
    done <<< "$CHANGED_POSTS"
    echo ""
else
    echo "ℹ️ 포스트 파일 변경 없음"
fi

echo "✅ Pre-commit hook 완료"
exit 0
